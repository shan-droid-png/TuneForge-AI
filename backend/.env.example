# TuneForge AI - Backend Environment Variables
# Copy to .env for local development:
# cp .env.example .env

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database Connection String (PostgreSQL via Prisma)
DATABASE_URL="postgresql://tuneforge_user:replace_with_a_secure_local_password@localhost:5432/tuneforge?schema=public"

# Future Authentication (Phase 2 placeholder)
JWT_SECRET=your_jwt_secret_key_placeholder
JWT_EXPIRES_IN=7d

# Future AI Music Generation API (Phase 3 placeholder)
AI_API_KEY=your_ai_provider_api_key_placeholder
AI_API_BASE_URL=https://api.example.com/v1
