generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------
// ENUMS
// -------------------------

enum SongStatus {
  DRAFT
  READY
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// -------------------------
// USER
// -------------------------

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs         Song[]
  conversations Conversation[]
  generations   Generation[]

  @@index([createdAt])
}

// -------------------------
// SONG
// -------------------------

model Song {
  id       String     @id @default(cuid())
  userId   String
  title    String     @default("Untitled Song")
  language String?
  genre    String?
  mood     String?
  status   SongStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lyricsVersions LyricsVersion[]
  conversations  Conversation[]
  generations    Generation[]

  @@index([userId, updatedAt])
}

// -------------------------
// LYRICS VERSION
// -------------------------

model LyricsVersion {
  id            String   @id @default(cuid())
  songId        String
  versionNumber Int
  lyrics        Json
  createdAt     DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, versionNumber])
  @@index([songId, createdAt])
}

// -------------------------
// AI CONVERSATION
// -------------------------

model Conversation {
  id     String  @id @default(cuid())
  userId String
  songId String?
  title  String  @default("New Conversation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  song     Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, updatedAt])
  @@index([songId])
}

// -------------------------
// CHAT MESSAGE
// -------------------------

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// -------------------------
// MUSIC GENERATION JOB
// -------------------------

model Generation {
  id            String           @id @default(cuid())
  userId        String
  songId        String?
  provider      String
  providerJobId String?
  status        GenerationStatus @default(QUEUED)
  prompt        String           @db.Text
  settings      Json?
  audioUrl      String?          @db.Text
  errorMessage  String?          @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song? @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([songId])
  @@index([status, createdAt])
}
