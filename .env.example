# TuneForge AI - Root Docker Compose Environment Configuration
# Copy this file to .env before starting Docker Compose:
# cp .env.example .env

# PostgreSQL Configuration
POSTGRES_DB=tuneforge
POSTGRES_USER=tuneforge_user
POSTGRES_PASSWORD=replace_with_a_secure_local_password
POSTGRES_PORT=5432

# Application Ports
FRONTEND_PORT=80
BACKEND_PORT=5000

# Backend Secrets & Configuration
JWT_SECRET=tuneforge_jwt_secret_change_in_production
AI_API_KEY=your_ai_provider_api_key_placeholder
